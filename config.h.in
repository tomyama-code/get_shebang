/* config.h.in */

#ifndef CONFIG_H
#define CONFIG_H

/* プロジェクトの情報 */
#cmakedefine PROJECT_NAME "@PROJECT_NAME@"
#cmakedefine PROJECT_VERSION "@PROJECT_VERSION@"

/* Name of package */
#cmakedefine PACKAGE

#cmakedefine IS_MSVC
#cmakedefine IS_GNU
#cmakedefine IS_CLANG
#cmakedefine UNKNOWN_DEV_ENV

#cmakedefine IS_TERMUX

#define NO_USE_GET_VERSION

/* unistd.h が利用可能か */
#cmakedefine HAVE_UNISTD_H

/* strncpy_s() が利用可能か */
#cmakedefine HAVE_STRNCPY_S

/* fopen_s() が利用可能か */
#cmakedefine HAVE_FOPEN_S

/* strerror_s() が利用可能か */
#cmakedefine HAVE_STRERROR_S

/* sprintf_s() が利用可能か */
#cmakedefine HAVE_SPRINTF_S

/* vsprintf_s() が利用可能か */
#cmakedefine HAVE_VSPRINTF_S

#endif /* CONFIG_H */
